<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>NotchFlow</string>
	<key>CFBundleDisplayName</key>
	<string>NotchFlow</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>ATSApplicationFontsPath</key>
	<string>Fonts</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UpdateRepository</key>
	<string>sidhxntt/NotchFlow</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>NotchFlow saves the lines you type in record mode into the Notes app.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>NotchFlow shows your upcoming calendar events in the notch workspace.</string>
	<key>NSCameraUsageDescription</key>
	<string>NotchFlow shows a camera preview when you enable the webcam capability.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Lofi-Lab</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>NotchFlow shows the current temperature under the clock. Your approximate location is rounded before it is sent to the weather service, and nothing else about it is stored or shared.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>NotchFlow files time-bound lines you type as reminders in the Reminders app.</string>
</dict>
</plist>
